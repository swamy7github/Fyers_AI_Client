# Copy this file to .env and fill in your own values. Never commit the real .env file.

FYERS_APP_ID=YOUR_APP_ID-100
FYERS_SECRET_KEY=YOUR_SECRET_KEY
FYERS_REDIRECT_URI=https://your-redirect-uri.com
FYERS_FY_ID=YOUR_FYERS_LOGIN_ID
FYERS_PIN=1234
FYERS_TOTP_SECRET=YOUR_TOTP_SECRET_FROM_FYERS_PROFILE

# Optional - only needed if you use global_sentiment.get_llm_news_sentiment()
ANTHROPIC_API_KEY=sk-ant-...
