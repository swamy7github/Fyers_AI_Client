
MODE=BACKTEST

# Fyers API v3 credentials (from https://myapi.fyers.in/dashboard)
FYERS_APP_ID=XXXXXXX-100
FYERS_APP_SECRET=your_app_secret_here
FYERS_REDIRECT_URI=https://127.0.0.1
FYERS_ACCESS_TOKEN_PATH=.fyers_token

# Capital & universe
PORTFOLIO_EQUITY=1000000
UNIVERSE_TOP_N=25

# Infra
DB_PATH=trading_engine.db
LOG_DIR=logs
LOG_LEVEL=INFO
API_MIN_INTERVAL_SEC=0.25

# Backtest window (only used when MODE=BACKTEST and --from/--to are not passed)
BACKTEST_FROM=2024-01-01
BACKTEST_TO=2024-12-31
