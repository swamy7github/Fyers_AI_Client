  \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mandatory-monthly-settlement-payout-to-be-initiated-on-7th-february-2026/\"\n        }\n    ],\n    \"2026-02-12\": [\n        {\n            \"id\": \"2026-02-12c59d84fd-89f6-4166-a81c-7690a4d43bcb\",\n            \"title\": \"Scalper is now live on the FYERS App!\",\n            \"body\": \"Place orders instantly with draggable target and stop loss directly on the chart using Scalper. Update your app to the latest version.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1770908679,\n            \"mobile\": 1,\n            \"web\": 0,\n            \"corporate_website\": 0,\n            \"fyers_web\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/scalper-execute-trades-at-the-speed-of-your-analysis-ZPJhVXmrwwOSdOg\"\n        },\n        {\n            \"id\": \"2026-02-1234933198-d6ee-402a-ac92-1e7e4e5a0735\",\n            \"title\": \"Draggable TP and SL now live!\",\n            \"body\": \"Drag and adjust your target and stop-loss directly on the chart. Risk management at your fingertips.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1770908736,\n            \"mobile\": 0,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/scalper-execute-trades-at-the-speed-of-your-analysis-ZPJhVXmrwwOSdOg\"\n        }\n    ],\n    \"2026-02-13\": [\n        {\n            \"id\": \"2026-02-131ed7e761-a4fb-4bf2-b48e-2f5364d6f251\",\n            \"title\": \"Scalper is now live on the FYERS App!\",\n            \"body\": \"Place orders instantly with draggable target and stop loss directly on the chart using Scalper. Update your FYERS App to the latest version\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1770957042,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/scalper-execute-trades-at-the-speed-of-your-analysis-ZPJhVXmrwwOSdOg\"\n        }\n    ],\n    \"2026-02-19\": [\n        {\n            \"id\": \"2026-02-1981e3043d-f966-4ce8-9749-930f568fe8e2\",\n            \"title\": \"Settlement Holiday Alert!\",\n            \"body\": \"Today, 19th Feb 2026, is a Settlement Holiday on account of Chhatrapati Shivaji Maharaj Jayanti. As a result, trades from 18th & 19th Feb will be settled on 20th Feb 2026. All withdrawals placed after 5:00 PM on 18th Feb will also be processed on 20th Feb 2026. \",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1771469988,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/settlement-holiday-on-february-19-2026/\"\n        },\n        {\n            \"id\": \"2026-02-195550ba06-9a83-4aa8-bfbc-31dec2c4f412\",\n            \"title\": \"Trade Gold & Silver with Lower Margin! \",\n            \"body\": \"MCX has removed the additional 3% margin on Gold Futures and 7% margin on Silver Futures. Trade with a reduced upfront margin starting today.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1771506214,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/gold-silver-futures-margin-revision-effective-19-feb-2026/\"\n        }\n    ],\n    \"2026-02-23\": [\n        {\n            \"id\": \"2026-02-23fa84434e-b987-4872-b6f1-36670c5cf365\",\n            \"title\": \"Quick View is LIVE!\",\n            \"body\": \"Access P&L, funds, Market Watch, and your favourite tools instantly. Long-press anywhere with two fingers to open.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1771824643,\n            \"mobile\": 1,\n            \"web\": 0,\n            \"corporate_website\": 0,\n            \"fyers_web\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/quick-view-your-trading-essentials-in-one-tap-v0o8EOTUdt48HdD\"\n        }\n    ],\n    \"2026-02-28\": [\n        {\n            \"id\": \"2026-02-28b54956f2-6bf7-4813-bc70-f8e9bec4ba11\",\n            \"title\": \"Positions P&L Curve is LIVE!\",\n            \"body\": \"Track your intraday P&L in real time, filter specific positions, set Smart Exit levels, all in one view.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1772262662,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/positions-p-l-curve-your-trading-day-explained-R13qFsTHxAgc1H8\"\n        }\n    ],\n    \"2026-03-02\": [\n        {\n            \"id\": \"2026-03-02d633b1cb-e74a-4bf9-8fbc-ea825dcdfc23\",\n            \"title\": \"Jan & Feb 2026: What We Built\",\n            \"body\": \"From Automate and Mobile Scalper to P&L curves and deeper analytics, discover everything that went live across the platform. Explore the complete recap.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1772438257,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/fyers-product-recap-jan-feb-2026-8o8sJXjLljr0KjD\"\n        }\n    ],\n    \"2026-03-03\": [\n        {\n            \"id\": \"2026-03-024bbe209a-2faa-4da0-8192-160660a6a74e\",\n            \"title\": \"MCX Evening Session Begins at 5:00 PM!\",\n            \"body\": \"Today is a trading holiday for NSE, BSE, and MCX (Morning Session) on account of Holi. However, the evening session of MCX and NCOM will begin at 5:00 PM. All withdrawal requests will be processed on Wednesday, i.e., 4th March 2026.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1772454089,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"\"\n        }\n    ],\n    \"2026-03-07\": [\n        {\n            \"id\": \"2026-03-066fe1d833-6474-4f4f-937a-fb4bec996c96\",\n            \"title\": \"\\ud83d\\udd14 Mock Trading Session Alert!\",\n            \"body\": \"We're participating in the exchange\\u2019s mock trading session today from 11 AM to 5 PM. During this time, you may notice price fluctuations on the charts.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1772775600,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mock-trading-session-on-7th-march-2026/\"\n        },\n        {\n            \"id\": \"2026-03-07c1527dc0-64a0-44fa-9082-f2ceb553c687\",\n            \"title\": \"\\ud83d\\udce2 Monthly / Non-traded payout processed!\",\n            \"body\": \"As per SEBI guidelines, the monthly or non-traded payout is under process. As a result, the funds may not reflect in your account until EOD. \",\n            \"type\": 3,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1772854156,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mandatory-monthly-non-traded-settlement-payout-7th-march-2026/\"\n        }\n    ],\n    \"2026-03-09\": [\n        {\n            \"id\": \"2026-03-0942423a6b-2cf6-4c43-bb86-449f22b1e099\",\n            \"title\": \"MCX Order Placement Issue\",\n            \"body\": \"Due to a technical issue at the MCX end across brokers from 7:14 PM, some clients may experience difficulties placing orders. We are actively coordinating with MCX to resolve this at the earliest. We appreciate your patience.\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1773066224,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"\"\n        }\n    ],\n    \"2026-03-10\": [\n        {\n            \"id\": \"2026-03-1072c2dacb-74f1-4cb1-9fd7-c60237f089c8\",\n            \"title\": \"Options Expiry: Crude Oil\",\n            \"body\": \"After yesterday\\u2019s surge on Gulf tensions, crude falls to \\u20b98,337 (-5.28%) on hopes of de-escalation. Options contracts expire today. Track your positions.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1773146497,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"\"\n        }\n    ],\n    \"2026-03-11\": [\n        {\n            \"id\": \"2026-03-1177ff93ca-197f-4bc6-b462-1c7cb4baf247\",\n            \"title\": \"New on FYERS: Charts & Indicators\",\n            \"body\": \"10 new indicators and custom timeframes are now live. Explore everything that\\u2019s new on charts in the FYERS Web or App.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1773211030,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/announcements-syobm28p/post/10-new-indicators-1-new-charting-tool-all-live-VZsXyqQ3uqUy7rW\"\n        }\n    ],\n    \"2026-03-19\": [\n        {\n            \"id\": \"2026-03-19e8b1b423-ee59-486f-a9f9-4edee068981f\",\n            \"title\": \"\\ud83d\\udce2 Settlement Holiday Alert!\",\n            \"body\": \"Due to the Settlement Holiday today on account of Gudhi Padwa, trades executed on 18th Mar will be settled on 20th Mar 2026. Accordingly, funds from these trades will be available for trading or withdrawal only after settlement is completed.\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1773889782,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/settlement-holiday-on-march-19-2026-gudhi-padwa/\"\n        }\n    ],\n    \"2026-03-20\": [\n        {\n            \"id\": \"2026-03-2048918c1b-ba01-4ef0-a372-2c9ddff7d43f\",\n            \"title\": \"What\\u2019s driving NIFTY right now?\",\n            \"body\": \"Spot opportunities faster with Heatmaps, Bubble Charts, FII/DII activity and more on Market Analytics in FYERS Web and App.\",\n            \"type\": 1,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1773992916,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/market-analytics-all-your-market-insights-in-one-place-icLmIbI66tDVWQj\"\n        }\n    ],\n    \"2026-03-21\": [\n        {\n            \"id\": \"2026-03-2196573a5b-9596-406a-b75c-3f77aae9b035\",\n            \"title\": \"Exchange Mock Trading Session\",\n            \"body\": \"We are participating in the exchange mock session today (9:00 AM\\u20133:30 PM). Price fluctuations may be visible. All data will be cleared by end of day.\",\n            \"type\": 3,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1774057556,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mock-trading-session-on-21st-march-2026/\"\n        }\n    ],\n    \"2026-03-26\": [\n        {\n            \"id\": \"2026-03-250f8fe25e-f6a3-4ff4-bc9d-473e6b4df41d\",\n            \"title\": \"MCX Evening Session Begins at 5:00 PM!\",\n            \"body\": \"Today is a trading holiday for NSE, BSE & MCX (Morning Session) on account of Shri Ram Navami. However, the evening session of MCX & NCOM will begin at 5:00 PM. All withdrawal requests will be processed on Friday, i.e., March 27th, 2026.\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1774457827,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/trading-holiday-on-march-26-2026-on-account-of-shri-ram-navami/\"\n        }\n    ],\n    \"2026-03-27\": [\n        {\n            \"id\": \"2026-03-272cbb544f-b6e7-443d-b566-907a3b66d3a1\",\n            \"title\": \"Find Your Next Trade Faster\",\n            \"body\": \"Explore 130+ screeners across 11 categories, analyse stocks with multiple viewing modes, and place trades without leaving the screener. From discovery to execution, in one place. Available on FYERS Web and App.\",\n            \"type\": 1,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1774589304,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n        