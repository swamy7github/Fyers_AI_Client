porate_website\": 0,\n            \"url\": \"https://app.fyers.in/discover/screeners/fia\"\n        }\n    ],\n    \"2025-05-28\": [\n        {\n            \"id\": \"2025-05-28efc1d16d-b266-45a2-a0fa-9256cfb1b1de\",\n            \"title\": \"\\ud83e\\udd14Find your top picks in seconds!\",\n            \"body\": \"Ask FIA\\u2014just like chatting with GPT. Instantly filter stocks & derivatives by Price, Volume, and OI. Try it now! \\ud83d\\udcc8\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1748408529,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://app.fyers.in/discover/screeners/fia\"\n        }\n    ],\n    \"2025-06-25\": [\n        {\n            \"id\": \"2025-06-25a4218d79-9b3d-447d-bf7c-0d768d4a8b65\",\n            \"title\": \"\\ud83d\\udce2Login Redirection Update!\",\n            \"body\": \"We\\u2019ve updated our login flow. After logging in via login.fyers.in, you\\u2019ll be redirected to fyers.in/web.\\nTo use Fyers Trader, visit trade.fyers.in or click on \\\"Go to previous version\\\"..\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1750827714,\n            \"mobile\": 0,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/notice-board/important-login-redirection-update/\"\n        }\n    ],\n    \"2025-07-23\": [\n        {\n            \"id\": \"2025-07-23b01aab69-f734-442f-a549-c822e71991ab\",\n            \"title\": \"MCX Update: Trading Resumed!\",\n            \"body\": \"Trading on MCX is back online. The earlier exchange-side issue has been resolved, and everything is now functioning smoothly. You can continue trading as usual.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1753246830,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"\"\n        }\n    ],\n    \"2025-09-03\": [\n        {\n            \"id\": \"2025-09-0371c9b7a9-61df-4b5a-a26f-3fdf9fc87221\",\n            \"title\": \"\\ud83d\\udce2Scheduled MF Maintenance\",\n            \"body\": \"Mutual Fund services will be unavailable today from 6:00 PM to 2:00 AM due to system upgrades. During this period, services like placing Buy/Redeem orders, creating new mandates, and related activities will not be accessible.\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1756898644,\n            \"mobile\": 1,\n            \"web\": 0,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mutual-funds-scheduled-maintenance/\"\n        }\n    ],\n    \"2025-09-05\": [\n        {\n            \"id\": \"2025-09-05ce888af1-a3be-49e0-97f2-1c6ea396c141\",\n            \"title\": \"\\ud83d\\udce2 Clearing Holiday Alert!\",\n            \"body\": \"Today, 5th Sept 2025, is a settlement holiday on account of Eid-e-Milad. In addition, 8th Sept 2025 (Monday) is also a settlement holiday. Trades from 4th\\u20138th Sept will be settled on 9th Sept 2025 (Tuesday). All withdrawals during this period will also be processed on 9th Sept. For more details \\ud83d\\udc49\\ud83c\\udffb\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1757044204,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/settlement-holiday-on-september-5-2025/\"\n        }\n    ],\n    \"2025-09-06\": [\n        {\n            \"id\": \"2025-09-05b6dd4a36-da1c-49b9-81c1-e133cdefb279\",\n            \"title\": \"\\ud83d\\udd14 Mock Trading Session Alert!\",\n            \"body\": \"We're participating in the exchange\\u2019s mock trading session today from 11 AM to 3:30 PM. During this time, you may notice price fluctuations on the charts.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1757075832,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mock-trading-session-6th-sep-2025/\"\n        }\n    ],\n    \"2025-09-08\": [\n        {\n            \"id\": \"2025-09-0860fd0b2f-8a56-4eea-aee6-1fbb666f5d45\",\n            \"title\": \"\\ud83d\\udce2 Clearing Holiday Update!\",\n            \"body\": \"As 5th Sept (Fri) and 8th Sept (Mon) are settlement holidays on account of Eid-e-Milad, trades from 4th & 5th will settle on 9th Sept, while trades from 8th & 9th will settle on 10th Sept. Withdrawals (Instant & Normal) will resume on 10th Sept.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1757301795,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/settlement-holiday-on-september-5-2025/\"\n        }\n    ],\n    \"2025-09-13\": [\n        {\n            \"id\": \"2025-09-127caca800-a22f-48f9-9253-426b2533f2bd\",\n            \"title\": \"\\ud83d\\udd14 Mock Trading Session Alert!\",\n            \"body\": \"We're participating in the exchange\\u2019s mock trading session today from 9 AM to 3:30 PM. During this time, you may notice price fluctuations on the charts.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1757684548,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mock-trading-session-13th-sep-2025/\"\n        }\n    ],\n    \"2025-09-27\": [\n        {\n            \"id\": \"2025-09-27f3668ea1-6d73-4c20-a1a8-ed5de4ef173c\",\n            \"title\": \"\\ud83d\\udd14 Mock Trading Session Alert!\",\n            \"body\": \"We're participating in the exchange\\u2019s mock trading session today from 10 AM to 3:00 PM. During this time, you may notice price fluctuations on the charts. To know more.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1758950166,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mock-trading-session-27th-sep-2025/\"\n        }\n    ],\n    \"2025-10-01\": [\n        {\n            \"id\": \"2025-10-01c1336d65-a567-42da-9aab-04486b9b8dab\",\n            \"title\": \"Live Market Feeds Update!\",\n            \"body\": \"All feeds are now live across FYERS Web, App, and Trader. Normal service has resumed. Thank you for your patience.\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1759301812,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"\"\n        }\n    ],\n    \"2025-10-11\": [\n        {\n            \"id\": \"2025-10-11fd6ab444-2a30-4257-bbc0-e3e23b83869f\",\n            \"title\": \"\\ud83d\\udd14 Mock Trading Session Alert!\",\n            \"body\": \"We're participating in the exchange\\u2019s mock trading session today from 9:00 AM to 4:00 PM. During this time, you may notice price fluctuations on the charts. To know more.\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1760150451,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/mock-trading-session-11th-oct-2025/\"\n        }\n    ],\n    \"2025-11-05\": [\n        {\n            \"id\": \"2025-11-04392bc489-2b55-4a96-b6e8-d3793f802c97\",\n            \"title\": \"\\ud83d\\udce2 MCX Evening Session Begins at 5:00 PM!\",\n            \"body\": \"Markets are closed for NSE, BSE & MCX (Morning Session) on account of Gurunanak Jayanti.\\nHowever, the evening session for MCX & NCOM will begin at 5:00 PM. All withdrawal requests will be processed on Thursday, November 06, 2025.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1762262842,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/trading-holiday-on-account-of-gurunanak-jayanti-november-05-2025/\"\n        }\n    ],\n    \"2025-12-08\": [\n        {\n            \"id\": \"2025-12-08f9081a48-ac97-47ef-977f-1ec22b19a9ea\",\n            \"title\": \"\\ud83d\\udce2 Pre-Open Session for Futures\",\n            \"body\": \"Starting today, Futures will have a 9:00 AM - 9:15 AM pre-open window, just like equity. Order entry/changes allowed till the random close around 9:07 - 9:08 AM.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1765163775,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/introduction-of-pre-open-session-in-equity-derivatives-fo/\"\n        }\n    ],\n    \"2025-12-24\": [\n        {\n            \"id\": \"2025-12-24d3a90e96-0c32-4e1c-9413-98bc4166d2ca\",\n            \"title\": \"Major Update: 3 New Tools\",\n            \"body\": \"Explore three new ways to analyse market trends with Market Analytics, FIA on charts, and enhanced Screeners.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1766558092,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/announcements-syobm28p/post/new-ways-to-analyse-markets-on-fyers-XUpH9ZQt5pjWf49\"\n        }\n    ],\n    \"2026-01-01\": [\n        {\n            \"id\": \"2026-01-01952108c2-c8fe-4898-97a5-f51bf3036a6c\",\n            \"title\": \"\\ud83d\\udce2Commodity trading ends at 5:00 PM today!\",\n            \"body\": \"The commodity market will be open only till 5:00 PM today. All intraday commodity positions will be squared off at 4:45 PM. The evening session will remain closed.\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1767245158,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/commodity-markets-to-close-early-on-january-1st-2026/\"\n        },\n        {\n            \"id\": \"2026-01-01fa7458aa-8baa-49e2-96a8-cd0b8d0ec471\",\n            \"title\": \"Cheers to 2026 - and to everything we built together!\",\n            \"body\": \"2025 was a year of growth, innovation, and powerful enhancements across your trading experience. Tap to explore the key highlights and see how we made trading smoother, smarter, and faster.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1767254091,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/fyers-2025-a-year-of-building-for-serious-traders-oexZi4iLhXxvLYh\"\n        }\n    ],\n    \"2026-01-03\": [\n        {\n            \"id\": \"2026-01-03496aca7e-14a8-4f62-81aa-89e568879272\",\n            \"title\": \"Quarterly settlement update\",\n            \"body\": \"Quarterly settlement payout will be processed today (3 Jan) as per guidelines. Any unused funds will be transferred to your primary bank account. Updated balance will reflect after 4:00 PM today.\",\n            \"type\": 3,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1767431875,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://support.fyers.in/portal/en/kb/articles/what-is-running-account-settlement-quarterly-settlement\"\n        }\n    ],\n    \"2026-01-23\": [\n        {\n            \"id\": \"2026-01-23c24c03c3-8df7-402f-b9dc-037b626167a1\",\n            \"title\": \"New: Chart and Options Analysis with FIA!\",\n            \"body\": \"FIA now analyses charts and option chains to give you clear, actionable insights. Spend less time preparing and more time trading.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1769149691,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/analyse-charts-easily-with-fia-EM1wQg4ZikfXYuw\"\n        }\n    ],\n    \"2026-01-30\": [\n        {\n            \"id\": \"2026-01-303cfb7650-e880-4b41-83ce-f91c8ad93ef0\",\n            \"title\": \"Budget Day Trading: Sunday Session (01 Feb)\",\n            \"body\": \"Markets will be open this Sunday (01-Feb-2026) across NSE, BSE & MCX on account of the Union Budget. A simpler way to track Budget-day market reactions is coming soon. Tap to check session timings, settlement details, and key trading rules.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1769751025,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/notice-board/special-live-trading-session-on-01-feb-26-for-union-budget-presentation/\"\n        }\n    ],\n    \"2026-01-31\": [\n        {\n            \"id\": \"2026-01-31ecc8bb1f-c1ca-40c5-a5d7-45ea73985265\",\n            \"title\": \"Introducing Live Budget Dashboard!\",\n            \"body\": \"Track the Finance Minister\\u2019s speech, key highlights, sector indices, and Budget themes live on 1st Feb in a single screen. Available on FYERS Web only.\",\n            \"type\": 1,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1769840581,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 1,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/live-budget-dashboard-track-live-speech-highlights-market-reaction-b459AWxky1Nl8j7\"\n        }\n    ],\n    \"2026-02-01\": [\n        {\n            \"id\": \"2026-02-01f19939f2-87fe-4dc0-ab10-5fe6a3ea2509\",\n            \"title\": \"Budget is Live\",\n            \"body\": \"Click 'Explore Now' to watch the live Budget session.\",\n            \"type\": 1,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1769923919,\n            \"mobile\": 0,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"fyers_web\": 0,\n            \"url\": \"https://fyers.in/web/markets/budget\"\n        },\n        {\n            \"id\": \"2026-02-01632694ab-d54e-4cea-b211-75ee09d03fbd\",\n            \"title\": \"Budget Session is Live\",\n            \"body\": \"Click 'Read more' to watch the live Budget session now.\",\n            \"type\": 1,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1769924719,\n            \"mobile\": 0,\n            \"web\": 0,\n            \"corporate_website\": 0,\n            \"fyer