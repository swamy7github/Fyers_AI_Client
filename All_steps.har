          "content": {
            "size": 112389,
            "mimeType": "x-unknown",
            "text": "{\n    \"common\": [],\n    \"updated_time\": 1788704539,\n    \"2024-08-22\": [\n        {\n            \"id\": \"2024-08-22690a39b4-4d7c-49a2-9306-05015b490c50\",\n            \"title\": \"\\ud83c\\udfafOne Tap, Deal Done!\",\n            \"body\": \"Instantly clear all your pending orders with Cancel All Orders. Explore now\\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1724307799,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/cancel-multiple-orders-with-a-single-click-rS8Qw8nVLT7Knzk\"\n        }\n    ],\n    \"2024-08-23\": [\n        {\n            \"id\": \"2024-08-23b2422fd8-55a1-4992-b540-155bfe2c9d79\",\n            \"title\": \"\\ud83c\\udfafOne Tap, Zero Hassle!\",\n            \"body\": \"Clear all open orders instantly with our new Cancel All Orders feature. Try it out now \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1724388433,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/cancel-multiple-orders-with-a-single-click-rS8Qw8nVLT7Knzk\"\n        }\n    ],\n    \"2024-09-02\": [\n        {\n            \"id\": \"2024-09-021713c771-c24b-46bc-be8e-33e3b87a515f\",\n            \"title\": \"\\ud83d\\udce2Introducing: Instant Access to Your Funds!\",\n            \"body\": \"Instantly withdraw up to \\u20b91 lakh, set up auto fund mandates, and easily add bank accounts with QR code scanning. Click to explore this feature \\u27a1\\ufe0f\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1725261999,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/instant-cash-withdrawals-and-seamless-bank-linking-1EBhlXUFmLoHEM3\"\n        }\n    ],\n    \"2024-09-04\": [\n        {\n            \"id\": \"2024-09-049bc9f500-3275-48a0-8b93-3caac41bf35b\",\n            \"title\": \"Don\\u2019t Miss Out: General Insurance (GICRE) OFS is Live!\",\n            \"body\": \"Invest in GICRE's Offer for Sale and diversify your portfolio with a trusted name in the insurance sector. The Offer for Sale is now open. To know more\\ud83d\\udc49\",\n            \"type\": 3,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1725442266,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://www.nseindia.com/market-data/ofs-information?symbol=GICRE&series=RS&type=Active\"\n        }\n    ],\n    \"2024-09-16\": [\n        {\n            \"id\": \"2024-09-16e1d2e6ff-59c6-4d5d-a3c0-5f30b0906fc9\",\n            \"title\": \"\\ud83d\\udce2 Clearing Holiday Alert!\",\n            \"body\": \"Today, 16th Sept 2024, is a settlement holiday on account of Eid-e-Milad. Therefore, trades from 13th & 16th Sept will be settled on 17th Sept 2024, i.e., tomorrow. All withdrawal requests will also be processed on 17th Sept 2024. For more details\\ud83d\\udc49\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1726458015,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/notice-board/settlement-holiday-on-16th-september-2024.html\"\n        }\n    ],\n    \"2024-09-17\": [\n        {\n            \"id\": \"2024-09-17067f3ef4-7d9f-4f72-a982-fe1b81cb449f\",\n            \"title\": \"\\ud83d\\udce2 Clearing Holiday Alert!\",\n            \"body\": \"Tomorrow, 18th Sept 2024, is a settlement holiday for Eid-e-Milad. Therefore, trades from 17th & 18th Sept will be settled on 19th Sept 2024. All withdrawal requests will be processed on 19th Sept 2024. For more details\\ud83d\\udc49\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1726580776,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/notice-board/settlement-holiday-on-18th-september-2024.html\"\n        }\n    ],\n    \"2024-09-18\": [\n        {\n            \"id\": \"2024-09-18c80608dc-7c55-4ca0-8fa0-eb227d32f235\",\n            \"title\": \"\\ud83d\\udce2 Clearing Holiday Alert!\",\n            \"body\": \"Today, 18th Sept 2024, is a settlement holiday on account of Eid-e-Milad. Therefore, trades from 17th & 18th Sept will be settled on 19th Sept 2024. All withdrawals will also be processed on 19th Sept, i.e., tomorrow. For more details \\ud83d\\udc49\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1726629321,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/notice-board/settlement-holiday-on-18th-september-2024.html\"\n        }\n    ],\n    \"2024-09-30\": [\n        {\n            \"id\": \"2024-09-30d80d3cd6-b097-4f15-a51e-5455d02e43b8\",\n            \"title\": \"\\ud83d\\udce2 Take Control with Smart Step!\",\n            \"body\": \"Simplify your trades with Smart Step. Set your buy and sell levels, average out with ease, and stay in control without constant monitoring. To know more, check out the blog \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1727684107,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/smart-step-simplifying-averaging-like-never-before-t9d7J4bQjh5lXes\"\n        }\n    ],\n    \"2024-10-01\": [\n        {\n            \"id\": \"2024-10-013a6dac19-9440-4a91-9f90-aebe2de59dfb\",\n            \"title\": \"\\ud83d\\udd12Lock-in gains with Smart Trail!\",\n            \"body\": \"Never let sudden market moves turn your gains into losses. With Smart Trail, your Trailing SL Orders adjust as prices move in your favor. Set your exit points and stay ahead. Click to learn more\\ud83d\\udc49\\n\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1727771690,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/smart-trail-lock-in-your-gains-in-volatile-markets-8E0anBbnZsQC0Wx\"\n        },\n        {\n            \"id\": \"2024-10-012c7efe43-4f40-4e4c-8ac2-ccbce642f1c9\",\n            \"title\": \"\\ud83d\\udce2 Trading Holiday Alert!\",\n            \"body\": \"Tomorrow, October 2nd, 2024, is a trading holiday for NSE, BSE, and MCX on account of Mahatma Gandhi Jayanti. All withdrawal requests will be processed on Thursday, i.e., 3rd October 2024.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1727783779,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/holiday-calendar/\"\n        }\n    ],\n    \"2024-10-04\": [\n        {\n            \"id\": \"2024-10-04bdaf55f8-2c3e-47de-950d-05ecc282073c\",\n            \"title\": \" \\ud83d\\udcc8 Start Trading with MTF!\",\n            \"body\": \"Margin Trading Facility (MTF) is now available. Access up to 4x margin and trade across 900 stocks. Don\\u2019t let this opportunity pass\\u2014Activate MTF today. To know more\\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1728023535,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/trade-equity-with-upto-4x-capital-with-margin-trading-facility-mtf-RWS53fzBqyqioX1\"\n        }\n    ],\n    \"2024-10-09\": [\n        {\n            \"id\": \"2024-10-095dcd53b1-d3ad-44f0-86a2-2334c4326d1f\",\n            \"title\": \"\\ud83d\\udcc8New Trading Policy Update!\",\n            \"body\": \"Now, sell your holdings and get 100% of the proceeds ready for same-day trading. More flexibility, more opportunities\\u2014right when you need them! To know more\\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1728461491,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/notice-board/100-holding-sale-proceeds-available-for-trading-from-9th-october-2024.html\"\n        }\n    ],\n    \"2024-10-18\": [\n        {\n            \"id\": \"2024-10-189873dada-0da3-4954-915f-7db86e209139\",\n            \"title\": \"Smart Exit \\ud83d\\udc49 Manage All at One Go!\",\n            \"body\": \"Tired of juggling multiple trades? Set one \\ud83c\\udfaf P&L target for all your positions with Smart Exit, and let the system handle a smooth exit. Don\\u2019t miss out - learn more \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1729236254,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/smart-exit-managing-positions-all-in-one-go-f7vsB5GAHzXVZmO\"\n        }\n    ],\n    \"2024-10-21\": [\n        {\n            \"id\": \"2024-10-21c2a90c4f-5c89-4c90-9985-d49250e2b1bd\",\n            \"title\": \"\\u23f3 Smart Limit Order \\ud83d\\udc49 Time Your Trades!\",\n            \"body\": \"Take full control by setting exact entry points with Smart Limit Orders. Adjust expiry times & easily convert them into market orders when needed. Click to explore more  \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1729493389,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/introducing-smart-limit-order-precision-and-control-redefined-4NDOboAkoewlTrG\"\n        }\n    ],\n    \"2024-10-22\": [\n        {\n            \"id\": \"2024-10-224cbaffd9-e946-4c83-8655-7114176cd5f7\",\n            \"title\": \"\\ud83d\\udce2 Live Webinar (\\u0939\\u093f\\u0902\\u0926\\u0940 \\u092e\\u0947\\u0902)!\",\n            \"body\": \"Smart order live webinar (\\u0939\\u093f\\u0902\\u0926\\u0940 \\u092e\\u0947\\u0902) is starting in less than 5 minutes at 12 PM! Don\\u2019t miss out on the chance to learn about Smart Orders with real-time market demos. Click to join now \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1729578496,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://youtube.com/live/Ep6kLSdSxE8\"\n        }\n    ],\n    \"2024-10-28\": [\n        {\n            \"id\": \"2024-10-2810858a6c-e69c-4338-8b63-49af84cf047a\",\n            \"title\": \"\\ud83c\\udf89FYERS Web Just Got Better!\",\n            \"body\": \"Explore the latest enhancements in FYERS Web and elevate your trading experience. Learn more \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1730082634,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://community.fyers.in/blogs-gdppin8d/post/fyers-web-upgraded-explore-enhanced-features-with-tradingview-v28-0-usP5pBXJGZ9cHqs\"\n        }\n    ],\n    \"2024-11-01\": [\n        {\n            \"id\": \"2024-11-01f1d6bfcc-ba86-46c3-b093-3318208c03a1\",\n            \"title\": \"\\ud83e\\ude94 Diwali Special: Muhurat Trading Alert!\",\n            \"body\": \"Today (Friday), join the auspicious Muhurat Trading session from 6:00 PM to 7:00 PM across all segments. Ensure a smooth trading experience by adding funds in advance, and make the most of this special opportunity to kick off Samvat 2081 on a high note. Click for details \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1730435618,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/notice-board/muhurat-trading-scheduled-on-friday-november-01-2024.html\"\n        }\n    ],\n    \"2024-11-27\": [\n        {\n            \"id\": \"2024-11-27948cc93d-2427-4427-a52a-f9ff695cfd03\",\n            \"title\": \"\\ud83c\\udfaf Simplistic Interface for Smarter Options Trading!\",\n            \"body\": \"Your options trading just got easier. The  Scalper Terminal lets you compare CE, PE, and the Spot side-by-side, trade direct from the charts, and customize your options chain. Click to explore the new features now\\ud83d\\udc49\\ud83c\\udffb\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1732683361,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/scalper-terminal-your-key-to-fast-efficient-options-trading-QyiQLUw4hsUZlM4\"\n        }\n    ],\n    \"2024-11-30\": [\n        {\n            \"id\": \"2024-11-3002339a4f-bbd5-40eb-a6a4-89b851a7ce0a\",\n            \"title\": \"\\ud83d\\udce2 3 Months of Zero Brokerage on NSE Commodities! \",\n            \"body\": \"Starting December 1, enjoy three months of Zero Brokerage on NSE Commodity trades! Don\\u2019t miss this opportunity to trade without fees. Explore the offer to know more\\u2014click on Read More. Get ready to save big! \\u23f3 Limited-time only!\",\n            \"type\": 3,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1732973409,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/nse-commodities-on-fyers-a-new-era-in-indian-trading-76jk0QA9qF7VLs5\"\n        }\n    ],\n    \"2024-12-12\": [\n        {\n            \"id\": \"2024-12-127ad46112-0938-4b71-8b5c-1e874e1cb144\",\n            \"title\": \"\\u231bStill Waiting for Trades to Trigger?\",\n            \"body\": \"Stop waiting! Set your target price with Good Till Triggered (GTT) orders and let trades execute automatically at the right price. Want to know more? Discover how\\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1733984310,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://support.fyers.in/portal/en/kb/articles/how-do-i-place-a-gtt-order-on-fyers-web\"\n        }\n    ],\n    \"2024-12-13\": [\n        {\n            \"id\": \"2024-12-13b74d28cc-5e9f-4740-840e-dd71ad81a0b3\",\n            \"title\": \"\\ud83d\\udcca Still haven't tried the Scalper Terminal? Let\\u2019s Go! \",\n            \"body\": \"Experience precision and speed with the Scalper Terminal! Compare CE, PE, and the Spot side-by-side, trade directly from charts, and customize your options chain\\u2014all designed to help you trade smarter and faster. Click to explore the features now\\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1734073266,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/scalper-terminal-your-key-to-fast-efficient-options-trading-QyiQLUw4hsUZlM4\"\n        }\n    ],\n    \"2024-12-18\": [\n        {\n            \"id\": \"2024-12-18cacb7448-fec0-4232-a836-81c52a823676\",\n            \"title\": \"\\ud83d\\udd25 Are Your Charts Keeping You Notified?\",\n            \"body\": \"Create Price Alerts instantly by clicking the \\u2795 on the price axis directly from the chart on our web platform. Try it now and stay ahead of the market!\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1734500541,\n            \"mobile\": 0,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"\"\n        }\n    ],\n    \"2024-12-20\": [\n        {\n            \"id\": \"2024-12-205e86304c-ca34-409f-8a31-6176e71793fc\",\n            \"title\": \"\\ud83d\\ude80Pledged Shares? Now Sell Them Instantly!\",\n            \"body\": \"No more waiting,no more hassle - sell pledged holdings instantly. Manage margins efficiently and handle trades seamlessly. Ready to enhance your trading experience? Click to know more\\ud83d\\udc49\\ud83c\\udffb\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1734674399,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/sell-pledged-holdings-without-unpledge-aiVmzMSU0lpv3MD\"\n        }\n    ],\n    \"2024-12-25\": [\n        {\n            \"id\": \"2024-12-25af75690e-7d19-4b73-b00d-df08093e764f\",\n            \"title\": \"\\ud83d\\udce2 Trading Holiday Alert!\",\n            \"body\": \"Today, December 25th, 2024, is a trading holiday for NSE, BSE, and MCX on account of Christmas. All withdrawal requests will be processed on Thursday, December 26th, 2024.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1735096041,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/holiday-calendar/\"\n        }\n    ],\n    \"2025-01-01\": [\n        {\n            \"id\": \"2025-01-0104bd8850-9ab6-4fab-81af-d702f6791bc5\",\n            \"title\": \"\\ud83c\\udf1f2024 Highlights You Can\\u2019t Miss! \",\n            \"body\": \"2024 was a year of tremendous growth, learning, and innovation. From introducing smarter features to successfully navigating market swings, we\\u2019ve had an eventful year. Tap to revisit the top moments. Here's to bold trades and a successful 2025! \\ud83d\\ude80\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1735702558,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/2024-wrap-up-reflecting-on-a-year-of-significant-progress-Nm27GvzpMBTPmTE\"\n        }\n    ],\n    \"2025-01-07\": [\n        {\n            \"id\": \"2025-01-072527f884-a739-4fcf-af6c-71d4d7d4e749\",\n            \"title\": \"\\u26a1 Tired of losing profits by over-trading?\",\n            \"body\": \"With Take a break, you can pause trading for the rest of the day after closing your positions. Stay in control, avoid over-trading, and safeguard your profits\\u2014all with a single click. Click to read more and improve your trading strategy \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1736232231,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/community/blogs-gdppin8d/post/pause-reflect-trade-smarter-with-take-a-break-VJ6gd01XTYjYB5t\"\n        }\n    ],\n    \"2025-01-28\": [\n        {\n            \"id\": \"2025-01-28d6cb112b-8740-432c-9644-9f2f6f1724a5\",\n            \"title\": \"\\ud83d\\udce2 Budget Countdown: Expiry Today!\",\n            \"body\": \"The wait is over! It\\u2019s the last Sensex expiry before the Union Budget. Plan your trades and stay ahead.\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1738035937,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"\"\n        }\n    ],\n    \"2025-01-30\": [\n        {\n            \"id\": \"2025-01-30bafe3d73-0932-4c76-a076-2f3d9253b87c\",\n            \"title\": \"Your Favorite Stocks, Now in BSE Futures!\",\n            \"body\": \"Futures trading on ICICI, HDFC, SBI, Axis, Infosys & Reliance is live. The next move is yours\\u2014Click to know more\\ud83d\\udc49\\ud83c\\udffb\",\n            \"type\": 1,\n            \"created_by\": \"shruti@fyers.in\",\n            \"time_created\": 1738213016,\n            \"mobile\": 1,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://fyers.in/community/announcements-syobm28p/post/bse-stock-futures-are-here-expand-your-trading-options-yVPcbDEDlutea9v\"\n        }\n    ],\n    \"2025-02-10\": [\n        {\n            \"id\": \"2025-02-1044e71b36-5df4-41c1-b30a-8ff44d33a117\",\n            \"title\": \"\\ud83d\\udd14 Auto DOM Centering is Back!\",\n            \"body\": \"TradingView removed it, but we've brought it back! Enable this feature in 'User Settings' on the Web and trade seamlessly. To learn more \\ud83d\\udc49\",\n            \"type\": 1,\n            \"created_by\": \"sounder@fyers.in\",\n            \"time_created\": 1739162413,\n            \"mobile\": 0,\n            \"web\": 1,\n            \"corporate_website\": 0,\n            \"url\": \"https://support.fyers.in/portal/en/kb/articles/how-to-enable-auto-dom-centering-in-fyers\"\n        }\n    ],\n    